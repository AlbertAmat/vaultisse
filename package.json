{
  "name": "vaultisse",
  "version": "1.3.8",
  "private": true,
  "description": "Vaultisse - self-hosted personal/library book tracker. npm workspaces monorepo: client/ (Vue web app), server/ (Express API) and packages/* (shared wire types and API client). The root version is the release anchor for the Docker pipeline.",
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbertAmat/vaultisse.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "npm run dev -w @vaultisse/server",
    "dev:client": "npm run dev -w @vaultisse/client",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test -w @vaultisse/server"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "uuid": "^11.1.1",
    "path-to-regexp": "0.1.13",
    "@types/express-serve-static-core": "5.0.7"
  }
}
