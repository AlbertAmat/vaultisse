# Copy this file to .env and fill in your local values.
# .env is git-ignored — never commit real secrets.

# Port the Express API listens on
API_PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vaultisse
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Optional: Google Books API key used to auto-fill book metadata from ISBN.
# Leave empty to fall back to the free Open Library API.
GOOGLE_BOOKS_API_KEY=

# Path to the log file written by the built-in logger
LOGGER_PATH=./logs.log

# Origin of the frontend, used for CORS and CSP (in dev, your Vite dev server URL)
FRONT_END_URL=http://localhost:5173

# Secret used to sign JWT session tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# Session/cookie lifetime in milliseconds
SESSION_TIME=3600000

# NEVER set to true in production: bypasses login with a fake dev session
ALLOW_DEV_AUTH=false

# Set to true to run this instance as a read-only public demo: rejects
# every non-GET request except the login flow. See DEPLOYMENT.md.
DEMO_MODE=false

# Set to true to require admin approval for new accounts: registration
# still succeeds, but the account is created disabled and can't log in
# until an admin manually enables it. See DEPLOYMENT.md.
REGISTRATION_REQUIRES_APPROVAL=false

# Set to true ONLY if a reverse proxy or tunnel sits in front of this app
# and sets X-Forwarded-* headers. Leave false for local dev.
TRUST_PROXY=false

# Verbose request tracing (raw SQL text, record names, usernames) written to
# LOGGER_PATH via the debug log level. Off by default - it can include
# personal data. Only enable temporarily while troubleshooting locally.
DEBUG_LOGGING=false

# Max size (in MB) accepted for a book's ebook file upload (.epub/.pdf/.mobi/.azw3).
# Increase this if your library has large scanned PDFs or big ebook files.
MAX_EBOOK_FILE_SIZE_MB=10

# Max size (in MB) accepted for a library import CSV (Goodreads export, or
# Vaultisse's own template - see POST /import/library).
MAX_IMPORT_FILE_SIZE_MB=10

# Optional OpenID Connect. Leave the four required values blank for
# password-only login. When set, /login also offers SSO. See
# docs/AUTHENTICATION.md. OIDC_REDIRECT_URI must be exact, e.g.
# http://localhost:3000/auth/oidc/callback (the API origin, not Vite).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_BUTTON_LABEL=Sign in with SSO
