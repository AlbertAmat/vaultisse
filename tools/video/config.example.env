# Copy this file to ~/.config/vaultisse-video/config.env and fill it in. That folder is OUTSIDE the repository: never commit the real file.
# (tools/video/README.md explains how Claude Code uses it.)

# Where the videos are written, one folder per video. Never inside the repository.
VIDEO_OUTPUT_DIR=~/Vaultisse-Videos

# --- YouTube (Data API v3, OAuth "Desktop app" client created in Google Cloud) ---
# The client file you download from Google Cloud, and where the approved token is kept after the first run.
YOUTUBE_CLIENT_SECRET=~/.config/vaultisse-video/client_secret.json
YOUTUBE_TOKEN=~/.config/vaultisse-video/token.json

# private (default, safest), unlisted or public. Set public only after you trust the result.
VIDEO_PRIVACY=private

# Playlists by name -> YouTube playlist id (optional). Videos whose episode script names a playlist are added to it.
# Example: Setup=PLxxxxxxxx,Admin=PLyyyyyyyy,Releases=PLzzzzzzzz
YOUTUBE_PLAYLISTS=

# --- Narration (YouTube does not speak subtitles; the video needs real audio, see the README) ---
# A command that turns text into a wav file, with {lang}, {text_file} and {out} placeholders. Leave empty to record your own voice
# and drop it in the video folder as audio/narration.en.wav.
# Example with Piper: VIDEO_TTS=piper --model ~/piper/{lang}.onnx --input_file {text_file} --output_file {out}
VIDEO_TTS=

# Royalty-free music you have the licence for (optional). Nothing else is ever used.
VIDEO_MUSIC_DIR=
