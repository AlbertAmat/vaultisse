# The smallest .env that runs Vaultisse with the admin console. Copy it to .env, fill in the values:
#
#   cp .env.minimal.example .env
#   docker compose up -d
#   docker compose logs app        # the first-admin username and password are printed here, once
#
# Everything else (email, registration, single sign-on, API keys, limits, notifications) is set from the
# console afterwards, with a setup guide on first login. Settings saved in the console take priority over
# any environment variable of the same name. Full list of variables: .env.example. Details: docs/ADMIN.md.

# --- Database (the compose file's db service is created from these) ---
DB_NAME=vaultisse
DB_USER=vaultisse
# Generate with: openssl rand -hex 24
DB_PASSWORD=

# --- Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Encrypts the secrets you save in the console (SMTP password, API keys...). Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# --- Where it is reached ---
# The address your users open. Used for CORS, security headers and the links in emails.
FRONT_END_URL=http://localhost:3000

# --- The admin console ---
ADMIN_ENABLED=true
# Where the console is opened (its own domain/port). Requests from any other origin are refused.
ADMIN_URL=http://localhost:3001
